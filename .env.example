VITE_APP_NAME=DDMS - Đặt tour đường thủy Đà Nẵng

# Backend API origin (no trailing slash). Prefer HTTP in Development to avoid SSL/redirect issues.
# launchSettings: http://localhost:6174  |  https://localhost:7161
VITE_API_URL=http://localhost:6174
# Path prefix appended to the API origin -> http://localhost:6174/api
VITE_API_URL_PREFIX=api
# development | production
VITE_APP_MODE=development
